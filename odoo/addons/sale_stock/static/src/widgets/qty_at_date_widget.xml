<?xml version="1.0" encoding="UTF-8" ?>
<template id="template" xml:space="preserve">

    <t t-name="sale_stock.QtyAtDate">
        <a t-att-tabindex="this.props.record.data.display_qty_widget ? '0' : '-1'"
            t-on-click="this.showPopup"
            t-att-class="!this.props.record.data.display_qty_widget ? 'invisible' : ''"
            t-attf-class="oi cursor-pointer {{ this.calcData().forecasted_issue ? 'text-danger' : '' }}"
         data-icon="area_chart"/>
    </t>

    <t t-name="sale_stock.QtyAtDatePopover">
        <div class="p-2">
        <h6>可用性</h6>
        <table class="table table-borderless table-sm">
            <tbody>
                <t t-if="!this.props.record.data.is_mto and ['draft', 'sent'].includes(this.props.record.data.state)">
                    <tr>
                        <td><strong t-out="this.forecastedLabel"/><br/><small>开 <span t-out="this.props.calcData.delivery_date"/></small></td>
                        <td class="text-end">
                            <b t-out='this.props.record.data.virtual_available_at_date' t-att-class="this.props.calcData.will_be_fulfilled ? 'text-success' : 'text-danger'"/> <t t-out='this.props.record.data.product_uom_id[1]'/>
                            <t t-if="this.props.record.data.product_uom_id[1] !== this.props.calcData.product_uom_name">
                                <br/><span t-out="this.props.calcData.product_uom_virtual_available_at_date" t-att-class="`fs-7 ${this.props.calcData.will_be_fulfilled ? 'text-success' : 'text-danger'}`"/> <span class="fs-7 text-muted" t-out='this.props.calcData.product_uom_name'/>
                            </t>
                        </td>
                    </tr>
                    <tr>
                        <td><strong t-out="this.availableLabel"/><br /><small>包括所有计划的作业</small></td>
                        <td class="text-end">
                            <b t-out='this.props.record.data.free_qty_today' t-att-class="this.props.calcData.hasAvailableStock ? 'text-success' : 'text-danger'"/> <t t-out='this.props.record.data.product_uom_id[1]'/>
                            <t t-if="this.props.record.data.product_uom_id[1] !== this.props.calcData.product_uom_name">
                                <br/><span t-out="this.props.calcData.product_uom_free_qty_today" t-att-class="`fs-7 ${this.props.calcData.hasAvailableStock ? 'text-success' : 'text-danger'}`"/> <span class="fs-7 text-muted" t-out='this.props.calcData.product_uom_name'/>
                            </t>
                        </td>
                    </tr>
                </t>
                <t t-elif="this.props.record.data.is_mto and ['draft', 'sent'].includes(this.props.record.data.state)">
                    <tr>
                        <td><strong>预计交货</strong></td>
                        <td class="oe-right"><span t-out="this.props.calcData.delivery_date"/></td>
                    </tr>
                    <tr>
                        <p>此产品根据需求补货。</p>
                    </tr>
                </t>
                <t t-elif="this.props.record.data.state == 'sale'">
                    <tr>
                        <td>
                            <strong>已预留</strong><br/>
                        </td>
                        <td style="min-width: 50px; text-align: right;">
                            <b t-out='this.props.record.data.qty_available_today'/> <t t-out='this.props.record.data.product_uom_id[1]'/>
                        </td>
                    </tr>
                    <tr t-if="this.props.record.data.qty_available_today &lt; this.props.record.data.qty_to_deliver">
                        <td>
                            <span t-if="this.props.calcData.will_be_fulfilled and this.props.calcData.forecast_expected_date_str">
                                剩余需求可在 <b t-out="this.props.calcData.forecast_expected_date_str" t-att-class="this.props.record.data.scheduled_date &lt; this.props.record.data.forecast_expected_date ? 'text-danger' : ''"/>
                            </span>
                            <span t-elif="!this.props.calcData.will_be_fulfilled and this.props.calcData.forecast_expected_date_str" class="text-danger">
                                预测可用数量不足
                            </span>
                            <span t-elif="!this.props.calcData.will_be_fulfilled" class="text-danger">
                                无预测可用數量
                            </span>
                            <span t-else="">
                                有现货
                            </span>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
        <button t-if="!this.props.record.data.is_mto" class="text-start btn btn-link"
            type="button" t-on-click="this.openForecast">
            <i class="oi oi-fw o_button_icon" data-icon="east"></i>
            查看预测
        </button>
        </div>
    </t>
</template>
